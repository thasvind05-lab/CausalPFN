import numpy as np
import matplotlib.pyplot as plt

# --- 1. Fit the data ---
# Change the degree (last argument) to 3 for a third-order polynomial
coeffs = np.polyfit(x, y, 3) 

# Extract coefficients: y = ax^3 + bx^2 + cx + d
a, b, c, d = coeffs 

# --- 2. Print the resulting function ---
# Updated to include the x^3 term
print(f"Fitted Function: y = ({a:.4e})x^3 + ({b:.4e})x^2 + ({c:.4e})x + ({d:.4e})")

# --- 3. Generate the fitted curve ---
# Create a smooth range of x values for the line plot
x_fit = np.linspace(min(x), max(x), 100)

# Calculate the corresponding y values using the 3rd-order equation
y_fit = a * x_fit**3 + b * x_fit**2 + c * x_fit + d 

# --- 4. Plot the data and the curve ---
plt.figure(figsize=(8, 5))

# Plot original data points
plt.scatter(x, y, color='blue', label='Experimental Data', zorder=2)

# Plot the fitted curve
plt.plot(x_fit, y_fit, color='red', linewidth=2, label='3rd Order Fit', zorder=3)

# Add labels and title
plt.xlabel('X Input (Units)')       # Update with your specific units
plt.ylabel('Y Output (Units)')      # Update with your specific units
plt.title('Calibration Curve: 3rd Order Polynomial Fit')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.6)

plt.show()
